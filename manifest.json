{
  "manifestVersion": 5,
  "id": "br.com.xtremefotos.darkroom",
  "name": "Xtreme Darkroom",
  "version": "0.1.0",
  "main": "index.html",
  "host": [
    {
      "app": "PS",
      "minVersion": "24.2.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "xtremeDarkroom",
      "label": {
        "default": "Xtreme Darkroom"
      },
      "minimumSize": { "width": 280, "height": 420 },
      "maximumSize": { "width": 420, "height": 2000 },
      "preferredDockedSize": { "width": 320, "height": 720 },
      "preferredFloatingSize": { "width": 320, "height": 780 },
      "icons": [
        { "width": 23, "height": 23, "path": "icons/icon_D.png", "theme": ["darkest", "dark", "medium"] },
        { "width": 23, "height": 23, "path": "icons/icon_N.png", "theme": ["lightest", "light"] }
      ]
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request",
    "clipboard": "readAndWrite",
    "network": {
      "domains": "all"
    }
  }
}
