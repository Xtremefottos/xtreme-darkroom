{
  "manifestVersion": 5,
  "id": "br.com.xtremefotos.darkroom.v2",
  "name": "Xtreme Darkroom",
  "version": "0.9.11",
  "main": "index.html",
  "host": [
    {
      "app": "PS",
      "minVersion": "24.2.0",
      "data": { "apiVersion": 2 }
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "xtremeDarkroomV2",
      "label": { "default": "Xtreme Darkroom" },
      "minimumSize": { "width": 280, "height": 480 },
      "maximumSize": { "width": 480, "height": 2000 },
      "preferredDockedSize": { "width": 320, "height": 780 },
      "preferredFloatingSize": { "width": 320, "height": 820 }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request",
    "clipboard": "readAndWrite"
  }
}
